{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "enum": [
        "idea",
        "validation",
        "pmf-search",
        "growth",
        "scale",
        "pivot",
        "unknown"
      ]
    },
    "personas": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "jobs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "name",
          "jobs"
        ]
      }
    },
    "features": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "surfaces": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "files": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "live",
              "partial",
              "placeholder",
              "broken",
              "unknown"
            ]
          },
          "evidence": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "personas": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "status"
        ]
      }
    },
    "ignoredSurfaces": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "surface": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "surface",
          "reason"
        ]
      }
    },
    "gaps": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "feature": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "surface": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "description",
          "severity"
        ]
      }
    },
    "facts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "openQuestions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "summary",
    "stage",
    "personas",
    "features"
  ]
}
