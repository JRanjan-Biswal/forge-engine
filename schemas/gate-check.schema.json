{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "artifact"
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "optional": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "artifact",
        "id",
        "description"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "file"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "nonEmpty": {
          "default": true,
          "type": "boolean"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "optional": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "path",
        "id",
        "description"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "metric"
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "pointer": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "type": "string",
          "enum": [
            ">=",
            "<=",
            ">",
            "<",
            "==",
            "!="
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "object",
              "properties": {
                "config": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "config"
              ]
            }
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "optional": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "artifact",
        "pointer",
        "op",
        "value",
        "id",
        "description"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "command"
        },
        "command": {
          "type": "string"
        },
        "configKey": {
          "type": "string"
        },
        "timeoutMs": {
          "default": 600000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "optional": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "id",
        "description"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "builtin"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "optional": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "name",
        "id",
        "description"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "rubric"
        },
        "minPassRatio": {
          "default": 0.9,
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "object",
              "properties": {
                "config": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "config"
              ]
            }
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "optional": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "id",
        "description"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "human"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "optional": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "id",
        "description"
      ]
    }
  ]
}
