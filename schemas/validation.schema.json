{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "idea": {
      "type": "string",
      "minLength": 1
    },
    "criteria": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "group": {
            "type": "string",
            "enum": [
              "problem",
              "market",
              "competition",
              "differentiation",
              "feasibility",
              "distribution",
              "monetization",
              "risk"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "default": 1,
            "type": "number",
            "exclusiveMinimum": 0
          },
          "answer": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "evidence": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "retrievedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                }
              },
              "required": [
                "url",
                "quote",
                "retrievedAt"
              ]
            }
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "group",
          "question",
          "answer"
        ]
      }
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "verdict": {
      "type": "string",
      "enum": [
        "go",
        "pivot",
        "kill",
        "needs-experiment"
      ]
    },
    "risks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "risk": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "required": [
          "risk",
          "severity"
        ]
      }
    },
    "experiments": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "cost": {
            "type": "string"
          },
          "signal": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "signal"
        ]
      }
    }
  },
  "required": [
    "idea",
    "criteria",
    "score",
    "verdict"
  ]
}
