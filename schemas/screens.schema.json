{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "screens": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "storyIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "route": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "enum": [
              "web",
              "ios",
              "android"
            ]
          },
          "components": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "states": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "empty",
                "loading",
                "error",
                "success"
              ]
            }
          },
          "stateless": {
            "default": false,
            "type": "boolean"
          },
          "copyKeys": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "storyIds",
          "route",
          "platform"
        ]
      }
    }
  },
  "required": [
    "screens"
  ]
}
